{
  "name": "locus-browser",
  "version": "0.1.0-canary.6",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "architecture:check": "node scripts/check-architecture.mjs",
    "build": "pnpm -r --if-present build",
    "canary:check": "node scripts/canary-readiness.mjs",
    "dev:desktop": "pnpm --filter @locus/browser-desktop dev",
    "dev:gallery": "pnpm --filter @locus/extension-gallery-service dev",
    "dist:canary": "pnpm --filter @locus/browser-desktop dist:canary",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:sbom": "node scripts/create-sbom.mjs",
    "release:update-metadata": "node scripts/create-update-metadata.mjs",
    "sync:verify-deployment": "node scripts/check-sync-deployment.mjs",
    "pretest": "pnpm --filter './packages/**' build",
    "pretypecheck": "pnpm --filter './packages/**' build",
    "renderer:budget": "node scripts/check-renderer-budget.mjs",
    "test": "node --test scripts/prepare-managed-component.test.mjs scripts/prepare-agent-runtime.test.mjs scripts/create-update-metadata.test.mjs && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
