{
  "name": "@locus/gallery-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "prebuild": "pnpm --filter @locus/extensions build",
    "pretest": "pnpm --filter @locus/extensions build",
    "pretypecheck": "pnpm --filter @locus/extensions build",
    "publish:production": "node scripts/publish-production.mjs",
    "test": "vitest run src",
    "types:worker": "wrangler types --env-interface GalleryWorkerBindings src/worker-configuration.d.ts",
    "typecheck": "wrangler types --env-interface GalleryWorkerBindings --check src/worker-configuration.d.ts && tsc -p tsconfig.json --noEmit",
    "verify:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@locus/extensions": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
